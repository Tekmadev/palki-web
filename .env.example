# Copy to .env.local for local development, and add the same values in Vercel → Settings → Environment Variables.

# ── Quote form (banquet page) ─────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Where quote requests are delivered. Separate multiple addresses with commas.
QUOTE_EMAIL_TO=
# Sender shown on the email. Must use a domain verified in Resend, e.g. "Palki Website <quotes@palkirestaurant.ca>".
# For testing only: "Palki Website <onboarding@resend.dev>" can deliver to your own Resend account email.
QUOTE_EMAIL_FROM=

# ── Site URL (optional on Vercel) ─────────────────────────────
# Used for canonical links, the sitemap and structured data. Vercel's production domain is used when unset.
NEXT_PUBLIC_SITE_URL=
